# Database
# Local development: file:./dev.db
# Docker Compose overrides this to file:/app/data/dev.db.
DATABASE_URL="file:./dev.db"

# Docker
APP_PORT=41832
TZ=Asia/Shanghai
# Keep 1001/1001 on Windows and most simple installs.
# On Linux, use the UID/GID that owns ./docker-data when needed.
PUID=1001
PGID=1001

# Authentication (required in production)
# Generate a unique random value of at least 32 characters.
AUTH_SECRET=
ADMIN_USER=zhuzhu
ADMIN_PASSWORD=
PARTNER_USER=zhubao
PARTNER_PASSWORD=

# AI API (provider 1 has the highest priority)
AI_BASE_URL_1=https://api.openai.com/v1
AI_API_KEY_1=
AI_MODEL_1=gpt-4o
AI_MODEL_LIGHT_1=gpt-4o-mini

AI_BASE_URL_2=
AI_API_KEY_2=
AI_MODEL_2=
AI_MODEL_LIGHT_2=

AI_BASE_URL_3=
AI_API_KEY_3=
AI_MODEL_3=
AI_MODEL_LIGHT_3=

# 即梦 AI / 小艺千问线稿服务
XYQ_ACCESS_KEY=
XYQ_BASE_URL=https://xyq.jianying.com

# Docker Compose already supplies the APP_* runtime storage paths.
# Only override these when running the production server without Compose.
# APP_UPLOADS_PATH=/app/public/uploads
# APP_UPLOADS_BACKUP_PATH=/app/uploads_backup
# APP_LINE_ARTS_PATH=/app/runtime-line-arts
# APP_SETTINGS_PATH=/app/server/data/settings.json
# APP_LINE_ART_HISTORY_PATH=/app/server/data/line-art-history.json
