# Database
# Local development: file:./dev.db
# Docker Compose overrides this to file:/app/data/dev.db
DATABASE_URL="file:./dev.db"

# Docker bind-mount owner.
# Keep 1001/1001 on Windows and most simple installs.
# On Linux, set these to the user that owns ./docker-data when needed.
PUID=1001
PGID=1001

# Auth
AUTH_SECRET=
ADMIN_USER=zhuzhu
ADMIN_PASSWORD=
PARTNER_USER=zhubao
PARTNER_PASSWORD=

# AI API (多 base URL，按优先级)
AI_BASE_URL_1=https://api.openai.com/v1
AI_API_KEY_1=
AI_MODEL_1=gpt-4o
AI_MODEL_LIGHT_1=gpt-4o-mini

AI_BASE_URL_2=
AI_API_KEY_2=
AI_MODEL_2=
AI_MODEL_LIGHT_2=

AI_BASE_URL_3=
AI_API_KEY_3=
AI_MODEL_3=
AI_MODEL_LIGHT_3=

# 小云雀
XYQ_ACCESS_KEY=
XYQ_BASE_URL=https://xyq.jianying.com
